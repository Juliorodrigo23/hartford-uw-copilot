# Copy to frontend/.env.local (and set the same vars in Vercel project settings).

# Cloud Run backend URL. When UNSET the chat page runs in clearly-labeled
# demo-replay mode (no live agent).
BACKEND_URL=https://uw-copilot-backend-xxxxx-uc.a.run.app

# Must match the backend's HMAC_SECRET (Secret Manager: hmac-secret)
HMAC_SECRET=change-me-32-bytes-of-randomness

# Serve under juliooo.com/hartford; leave empty to serve at the domain root
NEXT_PUBLIC_BASE_PATH=/hartford

# Proxy-level rate limit per IP per hour
RATE_LIMIT_PER_HOUR=20
