# Copy to frontend/.env.local (and set the same vars in Vercel project settings).

# Local FastAPI backend. Replace with the HTTPS Cloud Run service URL in
# Vercel. When UNSET, chat uses a clearly-labeled recorded demo replay.
BACKEND_URL=http://127.0.0.1:8080

# Must match the backend's HMAC_SECRET (Secret Manager: hmac-secret)
HMAC_SECRET=change-me-32-bytes-of-randomness

# Root is the zero-config local default. Set exactly `/hartford` in Vercel to
# serve under juliooo.com/hartford (then restart/redeploy; this is build-time).
NEXT_PUBLIC_BASE_PATH=

# Proxy-level rate limit per IP per hour
RATE_LIMIT_PER_HOUR=20
