# ============================================================================
# Drop-in secrets file. Copy to `.env` at the REPO ROOT (backend/app/config.py
# reads it from there) and fill in the two things that matter:
#
#   1. OPENAI_API_KEY  → enables the GPT judge (runtime critique + eval Track 2)
#   2. GCP_PROJECT_ID  → your Vertex AI project (Gemini generator)
#
# Everything else has sensible defaults.
# ============================================================================

# --- GCP / Vertex AI (auth via `gcloud auth application-default login`) -----
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
VERTEX_FAST_MODEL=gemini-3.5-flash-lite

# --- FMCSA QCMobile API (official carrier data; free key) --------------------
# Register at https://mobile.fmcsa.dot.gov/QCDevsite/ and paste the webKey.
# Without it, carrier lookups fall back to scraping the SAFER page, which is
# layout-fragile; garbage profiles are rejected rather than cached either way.
FMCSA_WEBKEY=

# --- OpenAI: cross-family LLM-as-judge --------------------------------------
# Used by the self_critique node (CRITIQUE_PROVIDER=auto/openai) and by
# scripts/07_run_evals.py Track 2. PASTE YOUR KEY HERE:
OPENAI_API_KEY=sk-...
OPENAI_JUDGE_MODEL=gpt-4o
# "auto" = GPT judge when a key is present, Gemini Flash otherwise
CRITIQUE_PROVIDER=auto

# --- Backend auth (the Vercel route signs requests with this) ---------------
HMAC_SECRET=change-me-32-bytes-of-randomness
# true for local dev; MUST be false in production (cloudbuild sets it)
ALLOW_UNSIGNED_DEV=true

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_PER_MIN=30

# --- RAG models (override for smaller machines) ------------------------------
# EMBED_MODEL=BAAI/bge-large-en-v1.5
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Enable background model loading in long-lived production services only.
WARM_RAG_MODELS=false

# --- SEC EDGAR requires a contact email in the User-Agent --------------------
SEC_EDGAR_USER_AGENT=Julio Contreras 23juliorod@gmail.com

# --- Observability (optional) -------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
