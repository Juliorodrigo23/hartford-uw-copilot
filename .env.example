# GCP / Vertex AI
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
VERTEX_MODEL=gemini-2.0-pro-exp-02-05
VERTEX_FAST_MODEL=gemini-2.0-flash

# LLM-as-judge (cross-family)
OPENAI_API_KEY=sk-...

# Optional rerank
COHERE_API_KEY=

# Backend auth (Vercel route signs requests with this)
HMAC_SECRET=change-me-32-bytes-of-randomness

# Frontend → backend
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_BASE_PATH=/hartford

# Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# SEC EDGAR requires a contact email in User-Agent
SEC_EDGAR_USER_AGENT=Julio Rodriguez 23juliorod@gmail.com
